# Django
SECRET_KEY=change-me-to-a-strong-random-secret-key
DEBUG=False
ALLOWED_HOSTS=mikapedia.online,www.mikapedia.online,localhost,127.0.0.1

# PostgreSQL database for Docker Compose production stack
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mikapedia_toms
DB_USER=mikapedia
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432

# JWT
JWT_SECRET_KEY=change-me-to-a-strong-random-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=https://mikapedia.online,https://www.mikapedia.online,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://mikapedia.online,https://www.mikapedia.online

# Redis for Channels + Celery
REDIS_URL=redis://redis:6379/0

# MT5
MT5_USE_SIMULATION=False
MT5_ENCRYPTION_KEY=replace-with-a-secure-random-key
EA_INTEGRATION_TOKEN=replace-with-a-secure-token

# TradingView Webhook
TRADINGVIEW_WEBHOOK_SECRET=mikapedia-tv-secret-2026

# Security hardening
SECURE_SSL_REDIRECT=True
